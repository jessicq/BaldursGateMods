@3000 = ~BG1: Zakrion's Portrait~
@3001 = ~Change Zakrion's portrait to Alternative 1 by bash-a at DeviantArt~
@4000 = ~Zakrion for BGII:EE and EET~
@5000 = ~Change Zakrion's class to Swashbuckler (from Duelist) in BG2~
@6000 = ~BG2: Zakrion's Portrait~
