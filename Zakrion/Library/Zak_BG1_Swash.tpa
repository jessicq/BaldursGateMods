// Alternative class
	COPY ~Zakrion/Zakrion_BG1/Creatures/QI#ZAKS.cre~ ~override/QI#ZAK.cre~
	WRITE_SHORT 0x246 0x400C

	SAY NAME1 @6
	SAY NAME2 @6

	SAY BIO @7
	SAY MORALE @8
	SAY UNHAPPY_ANNOYED @9
	SAY UNHAPPY_SERIOUS @10
	SAY LEADER @11
	SAY TIRED @12
	SAY BORED @13
	SAY AREA_NIGHT @14
	SAY AREA_DAY @15
	SAY AREA_DUNGEON @16
	SAY AREA_CITY @16
	SAY AREA_FOREST @17
	SAY BATTLE_CRY1 @18
	SAY BATTLE_CRY2 @19
	SAY BATTLE_CRY3 @20
	SAY BATTLE_CRY4 @21
	SAY BATTLE_CRY5 @22
	SAY DAMAGE @23
	SAY DYING @24
	SAY HURT @25
	SAY SELECT_COMMON1 @26
	SAY SELECT_COMMON2 @27
	SAY SELECT_COMMON3 @28
	SAY SELECT_COMMON4 @29
	SAY SELECT_COMMON5 @30
	SAY SELECT_COMMON6 @31
	SAY SELECT_ACTION1 @32
	SAY SELECT_ACTION2 @33
	SAY SELECT_ACTION3 @34
	SAY SELECT_ACTION4 @35
	SAY SELECT_ACTION5 @36
	SAY SELECT_ACTION6 @37
	SAY SELECT_ACTION7 @38
	SAY CRITICAL_HIT @39
	SAY CRITICAL_MISS @40
	SAY TARGET_IMMUNE @41
	SAY INVENTORY_FULL @42
	SAY SELECT_RARE1 @43
	SAY SELECT_RARE2 @44
	SAY PICKED_POCKET @45
	SAY SPELL_DISRUPTED @46
	SAY HIDDEN_IN_SHADOWS @47
	SAY SET_A_TRAP @48
	

BEGIN @49
  SUBCOMPONENT @50
  REQUIRE_FILE ~Zakrion/Zakrion_BG1/Zakrion_BG1.tpa~ @51
  ACTION_IF (FILE_EXISTS_IN_GAME ~FW0100.are~) OR (FILE_EXISTS_IN_GAME ~ar7200.are~) 
  THEN BEGIN
   COPY ~Zakrion/Zakrion_BG1/Portraits/BG/QI#ZA1L.bmp~ ~override/QI#ZakL.bmp~
   COPY ~Zakrion/Zakrion_BG1/Portraits/BG/QI#ZA1M.bmp~ ~override/QI#ZakM.bmp~
   COPY ~Zakrion/Zakrion_BG1/Portraits/BG/QI#ZA1S.bmp~ ~override/QI#ZakS.bmp~
  END ELSE BEGIN ACTION_IF FILE_EXISTS_IN_GAME ~neera.dlg~ 
  THEN BEGIN
   COPY ~Zakrion/Zakrion_BG1/Portraits/BGee/QI#ZA1L.bmp~ ~override/QI#ZakL.bmp~
   COPY ~Zakrion/Zakrion_BG1/Portraits/BGee/QI#ZA1M.bmp~ ~override/QI#ZakM.bmp~
   COPY ~Zakrion/Zakrion_BG1/Portraits/BGee/QI#ZA1S.bmp~ ~override/QI#ZakS.bmp~
  END
END