	COPY ~Zakrion/Zakrion_BG2/Creatures/QI#ZAK2S.cre~ ~override/QI#ZAK2.cre~
	
	SAY NAME1 @0
	SAY NAME2 @0

	SAY BIO @1
	SAY MORALE @2
	SAY UNHAPPY_ANNOYED @3
	SAY UNHAPPY_SERIOUS @4
	SAY LEADER @5
	SAY TIRED @6
	SAY BORED @7
	SAY AREA_NIGHT @8
	SAY AREA_DAY @9
	SAY AREA_DUNGEON @10
	SAY AREA_CITY @10
	SAY AREA_FOREST @11
	SAY BATTLE_CRY1 @12
	SAY BATTLE_CRY2 @13
	SAY BATTLE_CRY3 @14
	SAY BATTLE_CRY4 @15
	SAY BATTLE_CRY5 @16
	SAY DAMAGE @42
	SAY DYING @17
	SAY HURT @18
	SAY SELECT_COMMON1 @19
	SAY SELECT_COMMON2 @20
	SAY SELECT_COMMON3 @21
	SAY SELECT_COMMON4 @22
	SAY SELECT_COMMON5 @23
	SAY SELECT_COMMON6 @24
	SAY SELECT_ACTION1 @25
	SAY SELECT_ACTION2 @26
	SAY SELECT_ACTION3 @27
	SAY SELECT_ACTION4 @28
	SAY SELECT_ACTION5 @29
	SAY SELECT_ACTION6 @30
	SAY SELECT_ACTION7 @31
